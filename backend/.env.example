# Copier ce fichier en .env et remplir les valeurs

# Clé API 1min.ai — NE JAMAIS exposer côté frontend
ONEMIN_API_KEY=your_1min_ai_key_here

# Modèle IA (gpt-4o-mini recommandé pour la vitesse/coût)
AI_MODEL=gpt-4o-mini

# Firebase — chemin vers le fichier de service account JSON
# Télécharger depuis : Firebase Console > Paramètres > Comptes de service
# Laisser vide tant que l'app Android n'est pas intégrée
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Désactive la vérification Firebase (mettre false quand l'app Android sera prête)
SKIP_FIREBASE_AUTH=true

# Base de données (SQLite par défaut)
DATABASE_URL=sqlite:///./parcours.db

# Répertoire des logs (relatif au répertoire de lancement)
LOG_DIR=logs

# Mode d'exécution — development accepte les fake tokens
ENV=development